# ==========================================
# Configurações do R.A.F.F (opcional)
# ==========================================
# Copie este arquivo para .env e ajuste os valores.
# TODOS os valores abaixo têm padrão — o app funciona sem .env.

# Nome do estudante e do responsável (aparece nas telas do app)
STUDENT_NAME=Nome do Estudante
TEACHER_NAME=Nome do Responsável

# API da IA Gemini — necessária para geração de perguntas dinâmicas.
# Sem chave o app usa o banco local de questões ou as perguntas de emergência.
GEMINI_API_KEY=

# Modo IA (True = usa Gemini; False = usa apenas banco local)
AI_MODE=True

# Quantidade de perguntas geradas por sessão
AI_QUESTIONS_COUNT=5

# Quantidade máxima de feedbacks pedagógicos armazenados
MAX_FEEDBACKS=10

# Horários agendados para disparar o quiz automaticamente (HH:MM, separados por vírgula)
SCHEDULED_TIMES=10:00,15:00

# Aviso prévio antes de iniciar a atividade
START_WARNING_ENABLED=True
START_WARNING_MINUTES=5

# Som de conclusão da atividade (caminho para arquivo .wav, opcional)
COMPLETE_SOUND_PATH=

# Adaptadores de rede (nomes exatos exibidos pelo netsh — verifique em: netsh interface show interface)
NETWORK_DEVICE_1=Wi-Fi
NETWORK_DEVICE_2=Ethernet

# Matérias por dia da semana (0=Segunda … 6=Domingo)
# A IA usa essas matérias para gerar perguntas contextualizadas
WEEKDAY_0=Português
WEEKDAY_1=Matemática
WEEKDAY_2=Ciências
WEEKDAY_3=História
WEEKDAY_4=Geografia
WEEKDAY_5=Revisão Geral
WEEKDAY_6=Conhecimentos Gerais
