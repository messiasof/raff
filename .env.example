# ==========================================
# Configurações do R.A.F.F
# ==========================================

# URLs de controle
URL_QUESTIONS=https://pastebin.com/raw/exemplo
URL_CHECK=https://pastebin.com/raw/check
CHECK_CHAR=1

# Informações pessoais
STUDENT_NAME=Nome do Estudante
TEACHER_NAME=Nome do Responsável

# API da IA (Gemini)
GEMINI_API_KEY=sua_api_key_aqui

# Modo IA (True/False)
AI_MODE=True

# Aviso prévio antes de iniciar a atividade
START_WARNING_ENABLED=True
START_WARNING_TITLE=R.A.F.F
# Para avisos customizados em horários diferentes, use:
# python -m src.warn "Sua mensagem aqui"

# Som de conclusão da atividade (recomendado arquivo WAV)
COMPLETE_SOUND_PATH=

# Adaptadores de rede (nomes que aparecem no netsh)
NETWORK_DEVICE_1=Ethernet
NETWORK_DEVICE_2=Wi-Fi

# Matérias por dia da semana (0=Segunda, 6=Domingo)
# A IA usará essas matérias para gerar perguntas contextualizadas
WEEKDAY_0=Português
WEEKDAY_1=Português
WEEKDAY_2=Matemática
WEEKDAY_3=Matemática
WEEKDAY_4=Matemática
WEEKDAY_5=Inglês
WEEKDAY_6=Inglês

# Quantidade de perguntas a serem geradas pela IA
AI_QUESTIONS_COUNT=3

# Quantidade máxima de feedbacks armazenados
# A IA usa esse histórico para adaptar as perguntas
MAX_FEEDBACKS=10
